<?xml version="1.0"?>
<sdf version="1.10">
  <model name="course_ackermann">
    <pose>0 0 0.18 0 0 0</pose>
    <self_collide>false</self_collide>

    <link name="base_link">
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.55</ixx><iyy>1.10</iyy><izz>1.40</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry><box><size>1.05 0.52 0.22</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.12 0 0 0</pose>
        <geometry><box><size>1.05 0.52 0.22</size></box></geometry>
        <material><diffuse>0.05 0.36 0.72 1</diffuse></material>
      </visual>
    </link>

    <link name="front_left_knuckle">
      <pose>0.40 0.31 0 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
    </link>
    <link name="front_right_knuckle">
      <pose>0.40 -0.31 0 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
    </link>

    <link name="front_left_wheel">
      <pose>0.40 0.31 0 1.570796 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.006</ixx><iyy>0.003</iyy><izz>0.006</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.40 -0.31 0 1.570796 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.006</ixx><iyy>0.003</iyy><izz>0.006</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.40 0.31 0 1.570796 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.006</ixx><iyy>0.003</iyy><izz>0.006</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.40 -0.31 0 1.570796 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.006</ixx><iyy>0.003</iyy><izz>0.006</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.12</radius><length>0.07</length></cylinder></geometry><material><diffuse>0.04 0.04 0.04 1</diffuse></material></visual>
    </link>

    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_left_knuckle</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.55</lower><upper>0.55</upper><effort>25</effort></limit></axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>base_link</parent><child>front_right_knuckle</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.55</lower><upper>0.55</upper><effort>25</effort></limit></axis>
    </joint>
    <!-- Wheel links are rolled 90 degrees to orient the cylinders.
         Express the rolling axis in the model frame, not the rotated joint frame. -->
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_knuckle</parent><child>front_left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_knuckle</parent><child>front_right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child><axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
    </joint>

    <link name="camera_link">
      <pose>0.28 0 0.38 0 0 0</pose>
      <inertial><mass>0.033333333333</mass><inertia><ixx>0.000333333333</ixx><iyy>0.000333333333</iyy><izz>0.000333333333</izz></inertia></inertial>
      <sensor name="front_camera" type="camera">
        <frame_id>camera_link</frame_id>
        <gz_frame_id>camera_link</gz_frame_id>
        <topic>/vehicle/camera/image_raw</topic><update_rate>20</update_rate>
        <camera><horizontal_fov>1.396</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.1</near><far>50</far></clip></camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <link name="lidar_link">
      <pose>0.28 0 0.38 0 0 0</pose>
      <inertial><mass>0.033333333333</mass><inertia><ixx>0.000333333333</ixx><iyy>0.000333333333</iyy><izz>0.000333333333</izz></inertia></inertial>
      <sensor name="lidar" type="gpu_lidar">
        <frame_id>lidar_link</frame_id>
        <gz_frame_id>lidar_link</gz_frame_id>
        <topic>/vehicle/scan</topic><update_rate>10</update_rate>
        <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>20</max><resolution>0.02</resolution></range></lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    <link name="imu_link">
      <pose>0.28 0 0.38 0 0 0</pose>
      <inertial><mass>0.033333333334</mass><inertia><ixx>0.000333333334</ixx><iyy>0.000333333334</iyy><izz>0.000333333334</izz></inertia></inertial>
      <sensor name="imu" type="imu"><frame_id>imu_link</frame_id><gz_frame_id>imu_link</gz_frame_id><topic>/vehicle/imu</topic><update_rate>50</update_rate></sensor>
    </link>
    <joint name="imu_joint" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>

    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_base>0.8</wheel_base><wheel_separation>0.62</wheel_separation><kingpin_width>0.62</kingpin_width>
      <steering_limit>0.45</steering_limit><wheel_radius>0.12</wheel_radius>
      <min_velocity>-0.5</min_velocity><max_velocity>1.4</max_velocity>
      <min_acceleration>-2.0</min_acceleration><max_acceleration>1.5</max_acceleration>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>/model/course_ackermann/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
