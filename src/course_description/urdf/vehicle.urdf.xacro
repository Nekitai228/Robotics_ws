<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">
  <!-- SI; x forward, y left, z up. Dimensions from course kit v1-w08. -->
  <xacro:arg name="wheel_base" default="0.8"/>
  <xacro:arg name="track" default="0.62"/>
  <xacro:arg name="wheel_radius" default="0.12"/>
  <xacro:property name="wheel_base" value="$(arg wheel_base)"/>
  <xacro:property name="track" value="$(arg track)"/>
  <xacro:property name="radius" value="$(arg wheel_radius)"/>
  <xacro:property name="width" value="0.07"/>
  <xacro:macro name="inertia" params="mass ixx iyy izz">
    <inertial><mass value="${mass}"/><inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}" ixy="0" ixz="0" iyz="0"/></inertial>
  </xacro:macro>
  <link name="base_link">
    <xacro:inertia mass="12.0" ixx="0.55" iyy="1.10" izz="1.40"/>
    <visual><origin xyz="0 0 0.12"/><geometry><box size="1.05 0.52 0.22"/></geometry><material name="blue"><color rgba="0.05 0.36 0.72 1"/></material></visual>
    <collision><origin xyz="0 0 0.12"/><geometry><box size="1.05 0.52 0.22"/></geometry></collision>
  </link>
  <xacro:macro name="sensor" params="name parent:=base_link">
    <link name="${name}_link">
      <xacro:inertia mass="0.033333333333" ixx="0.000333333333" iyy="0.000333333333" izz="0.000333333333"/>
      <visual><geometry><box size="0.04 0.04 0.04"/></geometry><material name="orange"><color rgba="1 0.5 0 1"/></material></visual>
      <collision><geometry><box size="0.04 0.04 0.04"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/><child link="${name}_link"/>
      <origin xyz="0.28 0 0.38" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:sensor name="camera"/>
  <xacro:sensor name="lidar" parent="camera_link"/>
  <xacro:sensor name="imu"/>
  <xacro:macro name="wheel" params="name parent joint_x joint_y">
    <link name="${name}_wheel">
      <xacro:inertia mass="0.8" ixx="${0.8*(3*radius*radius+width*width)/12}" iyy="${0.8*radius*radius/2}" izz="${0.8*(3*radius*radius+width*width)/12}"/>
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${radius}" length="${width}"/></geometry><material name="black"><color rgba="0.04 0.04 0.04 1"/></material></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${radius}" length="${width}"/></geometry></collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="${parent}"/><child link="${name}_wheel"/>
      <origin xyz="${joint_x} ${joint_y} 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="front" params="side sign">
    <link name="front_${side}_knuckle"><xacro:inertia mass="0.2" ixx="0.001" iyy="0.001" izz="0.001"/></link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/><child link="front_${side}_knuckle"/>
      <origin xyz="${wheel_base/2} ${sign*track/2} 0"/><axis xyz="0 0 1"/>
      <limit lower="-0.55" upper="0.55" effort="25" velocity="2"/>
    </joint>
    <xacro:wheel name="front_${side}" parent="front_${side}_knuckle" joint_x="0" joint_y="0"/>
  </xacro:macro>
  <xacro:front side="left" sign="1"/>
  <xacro:front side="right" sign="-1"/>
  <xacro:wheel name="rear_left" parent="base_link" joint_x="${-wheel_base/2}" joint_y="${track/2}"/>
  <xacro:wheel name="rear_right" parent="base_link" joint_x="${-wheel_base/2}" joint_y="${-track/2}"/>
</robot>
